<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Exported so `adb shell am broadcast` (uid shell) can reach it; debug builds only -->
        <receiver
            android:name="com.nic.lgpower.TestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nic.lgpower.TEST_MARK" />
                <action android:name="com.nic.lgpower.TEST_WIDGETS" />
                <action android:name="com.nic.lgpower.TEST_LOG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
