<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Granted by Apple on request (2026-09); needed for the SSDP multicast
	     search and the Wake-on-LAN broadcast. The App ID carries the matching
	     capability, and the provisioning profile must be regenerated whenever
	     that changes. -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
